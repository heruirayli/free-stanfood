# fill with development or production
NODE_ENV=development

# port the Express API listens on
PORT=5000

# contact email included in the scraper's User-Agent
# (in GitHub Actions, set this as the repository secret SCRAPER_CONTACT_EMAIL)
SCRAPER_CONTACT_EMAIL=you@example.com

# address shown in the "request removal" link
HOST_REMOVAL_EMAIL=you@example.com

# Phase 4 only: LLM classification
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
